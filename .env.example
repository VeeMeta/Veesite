NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- BOW META members portal (/members) ---
# Hashed personal member codes. Comma-separated memberId:sha256hex pairs.
# Hash = SHA-256 hex of  "bmcode1:" + the code in uppercase (trimmed).
# Never put plaintext codes here. Vee's bot will send you an updated value
# when members are added or revoked. Paste it in Vercel and redeploy.
PORTAL_MEMBER_CODES=
# Long random string (32+ chars) used to sign the member cookie. e.g. `openssl rand -hex 32`
# Rotating this signs everyone out; it does not change their personal codes.
PORTAL_COOKIE_SECRET=
# "Ask Vee" emails via Resend (https://resend.com). If RESEND_API_KEY is empty,
# members get a ready-to-send mailto link instead.
RESEND_API_KEY=
# Where questions are delivered (server-side only — do not prefix with NEXT_PUBLIC_).
QUESTIONS_TO_EMAIL=
# Sending address, on a domain verified in Resend. e.g. BOW META Portal <portal@veemeta.com>
QUESTIONS_FROM_EMAIL=
